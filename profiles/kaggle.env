# Profile Kaggle (GPU T4 x2, 2 card 16 GB riêng, không bf16, không FlashAttention 2). Nạp bằng RUN_PROFILE=kaggle.
# Chỉ chứa khác biệt theo nơi chạy; khóa API lấy từ Kaggle Secrets (kaggle/runner.py), không ghi ở đây.
# Chia GPU: card 0 cho vLLM (Qwen), card 1 cho bge-m3 + Whisper của các worker harness.

# --- Model local (vLLM) ---
QWEN_MODEL=Qwen/Qwen3-4B
QWEN_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GPUS=0
VLLM_TP=1
VLLM_DTYPE=half
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEM=0.88
VLLM_EXTRA=
# vLLM cài trong venv riêng để không đụng torch/transformers của harness. Đặt ở /tmp: mọi thứ trong /kaggle/working
# thành output của notebook (giới hạn 20 GB, và `kaggle kernels output` tải về hết) — chỉ để kết quả ở đó.
VLLM_VENV=/tmp/vllm-venv

# --- Harness ---
EMBED_DEVICE=cuda:1
RAG_MODE=auto
WORKERS=4
TOOL_TRANSPORT=mcp
DATABASE_URL=sqlite:////kaggle/working/data/memory.db
LLM_CACHE=/kaggle/working/data/llm_cache.sqlite
HF_HOME=/tmp/hf
RUN_OUT=/kaggle/working/out
# model local trên T4 chậm hơn API: 4 worker × (router + generator + 2 lần trích) xếp hàng ở một server → 10 s là quá ngắn
EXTRACTOR_TIMEOUT_S=40
LLM_TIMEOUT_S=60

# v6p15 chốt 24/11/2026 (candidates/h13_v6p15_btc_tools_20261124, manifest 73f4d48d; H13 r7 81/86): cờ hành vi giống job Kaggle
ARCH=target
JEV_MODEL=jev-latest
REPLY_STYLE=short
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0
GOAL_CONTRACT=1
CONTRACT_V2=1
PRODUCT_LEXICON=1
ORDER_QTY=1
LEXICON_INCLUDE=approved
EXTRACTOR_LLM=qwen
PLANNER_SELECTOR=rules
UNDERSTANDING_TIMEOUT_S=20
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
PLANNER_B2_MAX_DECISIONS=10
PLANNER_B2_MAX_TOOL_CALLS=13
PLANNER_B2_DEADLINE_S=12
PLANNER_B2_MIN_CONF=0
PLANNER_B3_MAX_STEPS=8
PLANNER_VARIANT=b2_jev
AUDIT_ASYNC=1
B2_TWO_TIER=1
JEV_WRITE_GATE=1
B2TT_MAX_TOOL_CALLS=18
B2TT_MAX_DECISIONS=4
PII_NER=1
UNDERSTANDING_RETRY=1
ORDER_EXT_TOOLS=0
ADDRESS_SCOPE_GATE=1
WRITE_PATH_GATE=1
NULLABLE_EVIDENCE=1
TRIAL_TOTAL=1
PICK_BY_NAME=1
CLAIM_SPAN=1
DONE_NO_HANDOFF=0
DOC_ANSWER=1
LINE_SKU_UPDATE=1
