# Profile Kaggle (GPU T4 x2, 2 card 16 GB riêng, không bf16, không FlashAttention 2). Nạp bằng RUN_PROFILE=kaggle.
# Chỉ chứa khác biệt theo nơi chạy; khóa API lấy từ Kaggle Secrets (kaggle/runner.py), không ghi ở đây.
# Chia GPU: card 0 cho vLLM (Qwen), card 1 cho bge-m3 + Whisper của các worker harness.

# --- Model local (vLLM) ---
QWEN_MODEL=Qwen/Qwen3-8B-AWQ
QWEN_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GPUS=0
VLLM_TP=1
VLLM_DTYPE=half
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEM=0.88
VLLM_EXTRA=
# vLLM cài trong venv riêng để không đụng torch/transformers của harness. Đặt ở /tmp: mọi thứ trong /kaggle/working
# thành output của notebook (giới hạn 20 GB, và `kaggle kernels output` tải về hết) — chỉ để kết quả ở đó.
VLLM_VENV=/tmp/vllm-venv

# --- Harness ---
EMBED_DEVICE=cuda:1
RAG_MODE=auto
WORKERS=4
TOOL_TRANSPORT=mcp
DATABASE_URL=sqlite:////kaggle/working/data/memory.db
LLM_CACHE=/kaggle/working/data/llm_cache.sqlite
HF_HOME=/tmp/hf
RUN_OUT=/kaggle/working/out
# model local trên T4 chậm hơn API: 4 worker × (router + generator + 2 lần trích) xếp hàng ở một server → 10 s là quá ngắn
EXTRACTOR_TIMEOUT_S=40
LLM_TIMEOUT_S=60
