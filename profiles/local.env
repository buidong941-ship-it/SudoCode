# Profile máy cá nhân không GPU: chỉ chạy kiểm thử logic (router rules, generator offline, RAG BM25). Nạp bằng RUN_PROFILE=local.
# Muốn dùng Qwen từ máy này thì trỏ QWEN_BASE_URL tới server đang chạy vLLM (vd qua SSH tunnel: ssh -L 8000:127.0.0.1:8000 <server>).
QWEN_BASE_URL=http://127.0.0.1:8000/v1
RAG_MODE=bm25
EMBED_DEVICE=cpu
WORKERS=4
TOOL_TRANSPORT=direct
RUN_OUT=runs/suite
