# Profile server thuê (SSH / Termius). Nạp bằng RUN_PROFILE=server. Sửa theo máy: số GPU, VRAM.
# Mặc định cho máy 1 GPU 12–24 GB (vd RTX 3060 12 GB, A10 24 GB): vLLM và bge-m3 dùng chung card 0.
# Máy 2 GPU: đặt VLLM_GPUS=0 và EMBED_DEVICE=cuda:1 như profile kaggle.

# --- Model local (vLLM) ---
QWEN_MODEL=Qwen/Qwen3-8B-AWQ
QWEN_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GPUS=0
VLLM_TP=1
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=8192
# dùng chung card với bge-m3 (~2,3 GB mỗi worker) → để vLLM lấy ít hơn
VLLM_GPU_MEM=0.55
VLLM_EXTRA=
VLLM_VENV=.vllm-venv

# --- Harness ---
EMBED_DEVICE=cuda:0
RAG_MODE=auto
WORKERS=2
TOOL_TRANSPORT=mcp
RUN_OUT=runs/suite
EXTRACTOR_TIMEOUT_S=40
LLM_TIMEOUT_S=60
