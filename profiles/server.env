# Profile server thuê (SSH / Termius). Nạp bằng RUN_PROFILE=server. Sửa theo máy: số GPU, VRAM.
# Mặc định cho máy 1 GPU 12–24 GB (vd RTX 3060 12 GB, A10 24 GB): vLLM và bge-m3 dùng chung card 0.
# Máy 2 GPU: đặt VLLM_GPUS=0 và EMBED_DEVICE=cuda:1 như profile kaggle.

# --- Model local (vLLM) ---
QWEN_MODEL=Qwen/Qwen3-8B-AWQ
QWEN_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GPUS=0
VLLM_TP=1
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=8192
# dùng chung card với bge-m3 (~2,3 GB mỗi worker) → để vLLM lấy ít hơn
VLLM_GPU_MEM=0.55
VLLM_EXTRA=
VLLM_VENV=.vllm-venv

# --- Harness ---
EMBED_DEVICE=cuda:0
RAG_MODE=auto
WORKERS=2
TOOL_TRANSPORT=mcp
RUN_OUT=runs/suite
EXTRACTOR_TIMEOUT_S=40
LLM_TIMEOUT_S=60

# v6p15 chốt 24/11/2026 (candidates/h13_v6p15_btc_tools_20261124, manifest 73f4d48d; H13 r7 81/86): cờ hành vi giống job Kaggle
ARCH=target
JEV_MODEL=jev-latest
REPLY_STYLE=short
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0
GOAL_CONTRACT=1
CONTRACT_V2=1
PRODUCT_LEXICON=1
ORDER_QTY=1
LEXICON_INCLUDE=approved
EXTRACTOR_LLM=qwen
PLANNER_SELECTOR=rules
UNDERSTANDING_TIMEOUT_S=20
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
PLANNER_B2_MAX_DECISIONS=10
PLANNER_B2_MAX_TOOL_CALLS=13
PLANNER_B2_DEADLINE_S=12
PLANNER_B2_MIN_CONF=0
PLANNER_B3_MAX_STEPS=8
PLANNER_VARIANT=b2_jev
AUDIT_ASYNC=1
B2_TWO_TIER=1
JEV_WRITE_GATE=1
B2TT_MAX_TOOL_CALLS=18
B2TT_MAX_DECISIONS=4
PII_NER=1
UNDERSTANDING_RETRY=1
ORDER_EXT_TOOLS=0
ADDRESS_SCOPE_GATE=1
WRITE_PATH_GATE=1
NULLABLE_EVIDENCE=1
TRIAL_TOTAL=1
PICK_BY_NAME=1
CLAIM_SPAN=1
DONE_NO_HANDOFF=0
DOC_ANSWER=1
LINE_SKU_UPDATE=1
