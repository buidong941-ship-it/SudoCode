# Sao chép thành .env rồi điền khóa. KHÔNG commit file .env.

# Nơi chạy: đặt RUN_PROFILE=kaggle|server|local (biến môi trường, không đặt trong file này) để nạp profiles/<tên>.env —
# GPU nào cho model nào, số worker, đường dẫn. Xem docs/CHAY-KAGGLE-SERVER.md.

# --- Orchestrator / router: jev | llm (DeepSeek) | qwen (local) | rules (luật từ khóa, chỉ để kiểm thử offline)
ROUTER_BACKEND=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
ROUTER_MIN_CONFIDENCE=0.45

# --- Sinh lời thoại: deepseek | qwen (local qua vLLM) | offline (câu mẫu, chỉ để kiểm thử)
GENERATOR_BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# disabled = tắt suy luận của deepseek-v4-flash (bật thì TTFT ~3 s và token suy luận ăn hết LLM_MAX_TOKENS → câu cụt/rỗng)
DEEPSEEK_THINKING=disabled
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=350

# --- Model local (Qwen) qua vLLM, API tương thích OpenAI — bật server: bash scripts/serve_llm.sh start
# QWEN_BASE_URL=http://127.0.0.1:8000/v1
# QWEN_MODEL=Qwen/Qwen3-8B-AWQ
# disabled = tắt chế độ suy luận của Qwen3 (như DEEPSEEK_THINKING)
# QWEN_THINKING=disabled

# --- Bộ trích questions/claims/slot: rules | llm | hybrid (harness/llm_extract.py); LLM: qwen | deepseek
# EXTRACTOR_BACKEND=rules
# EXTRACTOR_LLM=qwen
# EXTRACTOR_TIMEOUT_S=10
# --- Tóm tắt phiên + handoff brief: auto (= LLM của generator) | qwen | deepseek | template
# SUMMARY_BACKEND=auto
# --- Cache kết quả LLM nhiệt độ 0 (bộ trích, router qwen, tóm tắt): đường dẫn SQLite, hoặc off
# LLM_CACHE=data/llm_cache.sqlite

# --- Tool + bộ nhớ đi qua MCP server (mcp-commerce, mcp-memory) hay gọi hàm trực tiếp: mcp | direct
TOOL_TRANSPORT=mcp
MCP_TIMEOUT_S=20
# MCP_MEMORY_MODE=ro      # chỉ cho server bộ nhớ mở tool đọc (UI xem bộ nhớ / QA)

# --- Bộ nhớ: mặc định SQLite (data/memory.db). Trên server dùng Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://callcenter:callcenter@localhost:5432/callcenter

# --- RAG chính sách (harness/rag.py). Mặc định đã nhắm tới server có GPU; máy yếu tự lùi xuống model nhỏ / BM25.
# RAG_MODE=auto                          # auto | hybrid (bắt buộc có model) | bm25
# EMBED_MODEL=BAAI/bge-m3                # máy yếu: intfloat/multilingual-e5-small
# EMBED_DEVICE=auto                      # auto | cuda | cpu
# RERANK_MODEL=off                      # server GPU: BAAI/bge-reranker-v2-m3 (đo có/không có rồi mới giữ)
# RERANK_TOP_N=20
# RAG_STORE=numpy                        # numpy | pgvector (cần DATABASE_URL Postgres ở trên)

# --- ASR (asr/transcribe.py): auto = GPU → large-v3, CPU → small
# ASR_MODEL=auto

# --- Dữ liệu ngoài repo (dataset/, runs/) lưu trên Drive: link chia sẻ của từng file .tar.gz — scripts/data_fetch.sh đọc ở đây
# DRIVE_DATASET=https://drive.google.com/file/d/<ID>/view?usp=sharing
# DRIVE_RUNS=https://drive.google.com/file/d/<ID>/view?usp=sharing

# --- Log: mức ghi vào <out>.log (DEBUG | INFO | WARNING | ERROR). `run_eval.py -v` = DEBUG + in từng lượt ra màn hình.
LOG_LEVEL=INFO
