# Sao chép thành .env rồi điền khóa. KHÔNG commit file .env.

# Nơi chạy: đặt RUN_PROFILE=kaggle|server|local (biến môi trường, không đặt trong file này) để nạp profiles/<tên>.env —
# GPU nào cho model nào, số worker, đường dẫn. Xem docs/CHAY-KAGGLE-SERVER.md.

# --- Orchestrator / router: jev | llm (DeepSeek) | qwen (local) | rules (luật từ khóa, chỉ để kiểm thử offline)
ROUTER_BACKEND=jev
TYPESAFE_API_KEY=
# Provider: TypeSafe (Jev). Key chính thức: để trống TYPESAFE_BASE_URL, model jev-latest (các canary từ 05/11/2026 chạy cấu hình này)
JEV_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
ROUTER_MIN_CONFIDENCE=0.45

# --- Sinh lời thoại: deepseek | qwen (local qua vLLM) | offline (câu mẫu, chỉ để kiểm thử)
GENERATOR_BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# disabled = tắt suy luận của deepseek-v4-flash (bật thì TTFT ~3 s và token suy luận ăn hết LLM_MAX_TOKENS → câu cụt/rỗng)
DEEPSEEK_THINKING=disabled
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=160

# --- Model local (Qwen) qua vLLM, API tương thích OpenAI — bật server: bash scripts/serve_llm.sh start
# QWEN_BASE_URL=http://127.0.0.1:8000/v1
# QWEN_MODEL=Qwen/Qwen3-8B-AWQ
# disabled = tắt chế độ suy luận của Qwen3 (như DEEPSEEK_THINKING)
# QWEN_THINKING=disabled

# --- Bộ trích questions/claims/slot: rules | llm | hybrid (harness/llm_extract.py); LLM: qwen | deepseek
# EXTRACTOR_BACKEND=rules
# EXTRACTOR_LLM=qwen
# EXTRACTOR_TIMEOUT_S=10
# EXTRACTOR_CONFIDENCE_GATE=0       # thử nghiệm: rules được nhận khi sáu kiểm tra G/P/U/N/K/C đều đạt
# EXTRACTOR_JEV_HYBRID=0           # thử nghiệm: Jev gán nhãn, Qwen xử lý span/giá trị chưa chắc chắn; cần TYPESAFE_API_KEY
# --- Tóm tắt phiên + handoff brief: auto (= LLM của generator) | qwen | deepseek | template
# SUMMARY_BACKEND=auto
# --- Cache kết quả LLM nhiệt độ 0 (bộ trích, router qwen, tóm tắt): đường dẫn SQLite, hoặc off
# LLM_CACHE=data/llm_cache.sqlite

# --- Tool + bộ nhớ đi qua MCP server (mcp-commerce, mcp-memory) hay gọi hàm trực tiếp: mcp | direct
TOOL_TRANSPORT=mcp
MCP_TIMEOUT_S=20
# MCP_MEMORY_MODE=ro      # chỉ cho server bộ nhớ mở tool đọc (UI xem bộ nhớ / QA)

# --- Bộ nhớ: mặc định SQLite (data/memory.db). Trên server dùng Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://callcenter:callcenter@localhost:5432/callcenter

# --- RAG chính sách (harness/rag.py). Mặc định đã nhắm tới server có GPU; máy yếu tự lùi xuống model nhỏ / BM25.
# RAG_MODE=auto                          # auto | hybrid (bắt buộc có model) | bm25
# EMBED_MODEL=BAAI/bge-m3                # máy yếu: intfloat/multilingual-e5-small
# EMBED_DEVICE=auto                      # auto | cuda | cpu
# RERANK_MODEL=off                      # server GPU: BAAI/bge-reranker-v2-m3 (đo có/không có rồi mới giữ)
# RERANK_TOP_N=20
# RAG_STORE=numpy                        # numpy | pgvector (cần DATABASE_URL Postgres ở trên)

# --- ASR (asr/transcribe.py): faster-whisper (local, tự host). auto = GPU → large-v3 (float16, ~5 GB VRAM), CPU → small (int8)
# Trọng số tự tải từ Hugging Face lần chạy đầu (cần Internet). Không dùng API ASR ngoài.
# ASR_MODEL=auto
# --- TTS: hệ thống agent KHÔNG dùng TTS. Chỉ asr/make_audio.py (công cụ BTC tạo audio public D01–D04) dùng edge-tts (miễn phí, cần Internet).

# --- Đường đích (ARCH=target) và các cờ candidate — ĐANG THỬ NGHIỆM, chưa chốt cấu hình nộp (xem docs/DE-XUAT/*):
# ARCH=target                      # bộ hiểu DeepSeek (understanding.py) điều khiển pipeline
# PLANNER_VARIANT=b2_jev           # Jev chọn bước; giao dịch do code thực thi
# B2_TWO_TIER=1
# JEV_WRITE_GATE=1                 # cổng Jev cho quyết định ghi (đặt / sửa / rút yêu cầu)
# UNDERSTANDING_RETRY=1            # trích lại đúng một lần khi output bộ hiểu tự mâu thuẫn / sai kiểu
# ORDER_EXT_TOOLS=1                # tool riêng order.update_line / order.cancel (harness/order_ext.py); 0 = chỉ tool BTC
# PII_NER=1                        # che địa chỉ trước khi gửi API ngoài bằng NER local + regex dự phòng
#   Model NER: Keithsel/Aster-Vietnamese-NER-MiniLM (Hugging Face, transformers pipeline, chạy CPU, tải lần đầu cần Internet).
#   LƯU Ý: model card chưa ghi license → chưa dùng được cho bản nộp cho tới khi xác nhận.
# QWEN_MODEL=Qwen/Qwen3-4B         # generator / extractor local qua vLLM (canary: GPU T4 x2, VLLM_MAX_MODEL_LEN=8192)

# --- Dữ liệu ngoài repo (dataset/, runs/) lưu trên Drive: link chia sẻ của từng file .tar.gz — scripts/data_fetch.sh đọc ở đây
# DRIVE_DATASET=https://drive.google.com/file/d/<ID>/view?usp=sharing
# DRIVE_RUNS=https://drive.google.com/file/d/<ID>/view?usp=sharing

# --- Log: mức ghi vào <out>.log (DEBUG | INFO | WARNING | ERROR). `run_eval.py -v` = DEBUG + in từng lượt ra màn hình.
LOG_LEVEL=INFO

# v6p15 chốt 24/11/2026 (candidates/h13_v6p15_btc_tools_20261124, manifest 73f4d48d; H13 r7 81/86): cờ hành vi giống job Kaggle
ARCH=target
REPLY_STYLE=short
GOAL_CONTRACT=1
CONTRACT_V2=1
PRODUCT_LEXICON=1
ORDER_QTY=1
LEXICON_INCLUDE=approved
EXTRACTOR_LLM=qwen
PLANNER_SELECTOR=rules
UNDERSTANDING_TIMEOUT_S=20
PLANNER_B2_MAX_DECISIONS=10
PLANNER_B2_MAX_TOOL_CALLS=13
PLANNER_B2_DEADLINE_S=12
PLANNER_B2_MIN_CONF=0
PLANNER_B3_MAX_STEPS=8
PLANNER_VARIANT=b2_jev
AUDIT_ASYNC=1
B2_TWO_TIER=1
JEV_WRITE_GATE=1
B2TT_MAX_TOOL_CALLS=18
B2TT_MAX_DECISIONS=4
PII_NER=1
UNDERSTANDING_RETRY=1
ORDER_EXT_TOOLS=0
ADDRESS_SCOPE_GATE=1
WRITE_PATH_GATE=1
NULLABLE_EVIDENCE=1
TRIAL_TOTAL=1
PICK_BY_NAME=1
CLAIM_SPAN=1
DONE_NO_HANDOFF=0
DOC_ANSWER=1
LINE_SKU_UPDATE=1
