{
  "version": 1,
  "note": "Lexicon nhận biết slot (PLAN-2026-11-01 A-L). Pattern khớp trên fold() (không dấu, chữ thường). Chỉ entry status=approved được dùng lúc chạy; duyệt bằng scripts/lexicon_review.py. Xem harness/lexicon/__init__.py. Viết tắt đã có trong harness/textnorm.py TEEN (ko, k, dc, bn, mk, v, j...) không lặp lại ở đây.",
  "slots": {
    "size": {
      "description": "size / cỡ / số giày áo khách chọn",
      "entries": [
        {
          "id": "size.neg.so_nha",
          "kind": "negative",
          "drop_if_value_in_match": true,
          "pattern": "\\b((giao|ship|gui|chuyen)( hang)? (ve|toi|den|ra|vo|vao)|dia chi( moi| giao)?( la)?|(nha|minh|chi|anh|em) o) so \\d{1,4}\\b",
          "examples": [
            {
              "text": "Giao về số 12 Nguyễn Trãi, Thanh Xuân, Hà Nội giúp anh.",
              "expect": {
                "size": null,
                "address": "số 12 Nguyễn Trãi, Thanh Xuân, Hà Nội"
              }
            },
            {
              "text": "Địa chỉ mới là số 7 Lê Lợi, Quận 1 nhé.",
              "expect": {
                "size": null
              }
            },
            {
              "text": "Anh lấy giày số 42 nhé.",
              "expect": {
                "size": "42"
              }
            },
            {
              "text": "Cho chị size 38 màu trắng.",
              "expect": {
                "size": "38"
              }
            }
          ],
          "source": "demo C.6 (docs/LOI-2026-11-01.md L1)",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        }
      ]
    },
    "payment": {
      "description": "cách thanh toán khách CHỌN (COD / bank)",
      "entries": [
        {
          "id": "payment.neg.hoi_kha_nang",
          "kind": "negative",
          "pattern": "\\b(cod|chuyen khoan|ck|thanh toan khi nhan)\\b[^.?!]{0,15}\\b(duoc khong|co duoc khong|duoc ko|the nao|nhu the nao|ra sao)\\b",
          "examples": [
            {
              "text": "Chuyển khoản được không em?",
              "expect": {
                "payment": null
              }
            },
            {
              "text": "Thanh toán khi nhận hàng được không em?",
              "expect": {
                "payment": null
              }
            },
            {
              "text": "Anh chuyển khoản trước nhé.",
              "expect": {
                "payment": "bank"
              }
            },
            {
              "text": "Ship COD giúp chị nha.",
              "expect": {
                "payment": "COD"
              }
            }
          ],
          "source": "PLAN-2026-11-01 A-D2 (phản ví dụ 'chuyển khoản được không')",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        },
        {
          "id": "payment.cue.ck",
          "kind": "cue",
          "pattern": "\\bck\\b",
          "examples": [
            {"text": "A vừa ck, kích hoạt giúp a.", "hit": true},
            {"text": "Dạ em cảm ơn nhé.", "hit": false}
          ],
          "source": "real_ref (cert_v2_check 02/11: 7 câu 'ck' = chuyển khoản bị chứng nhận rỗng sai). Chỉ là cue → bỏ phiếu trắng, không đặt giá trị (ck cũng có nghĩa 'chồng')",
          "added": "2026-11-02",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "claude (user-delegated 02/11, D14)"
        },
        {
          "id": "payment.value.bank_teencode",
          "kind": "value",
          "value": "bank",
          "pattern": "\\b(ck (truoc|luon|qua)|chuyen tien (truoc|luon|qua)|qua app ngan hang|internet banking|banking luon)\\b",
          "examples": [
            {
              "text": "Mình ck trước luôn cho nhanh nhé.",
              "expect": {
                "payment": "bank"
              }
            },
            {
              "text": "Chị chuyển tiền trước qua app được chứ?",
              "expect": {
                "payment": "bank"
              }
            },
            {
              "text": "Shop gửi số tài khoản để mình kiểm tra lại đơn nhé.",
              "expect": {
                "payment": null
              }
            }
          ],
          "source": "ref:hcmut-ura (đếm thô 01/11: ~200 câu có ck/chuyển khoản/stk)",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        },
        {
          "id": "payment.value.cod_noi_tu_nhien",
          "kind": "value",
          "value": "COD",
          "pattern": "\\b(nhan hang (roi )?(moi )?(tra|thanh toan|dua tien)|tra (tien )?khi nhan|giao toi dau tra toi do|tien tay)\\b",
          "examples": [
            {
              "text": "Nhận hàng rồi mới thanh toán nha em.",
              "expect": {
                "payment": "COD"
              }
            },
            {
              "text": "Trả khi nhận được không, à thôi cứ trả khi nhận đi.",
              "expect": {
                "payment": "COD"
              }
            },
            {
              "text": "Bao giờ thì nhận hàng em?",
              "expect": {
                "payment": null
              }
            }
          ],
          "source": "claude-synth (cách nói COD miền Nam/Bắc)",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        }
      ]
    },
    "has_children": {
      "description": "nhà có trẻ nhỏ / em bé",
      "entries": [
        {
          "id": "has_children.neg.be_ca",
          "kind": "negative",
          "pattern": "\\b(be ca|be nuoc|be boi|be chua|be phot|ho ca|be thuy sinh)\\b",
          "examples": [
            {
              "text": "Máy lọc này dùng cho bể cá được không em?",
              "expect": {
                "has_children": null
              }
            },
            {
              "text": "Nhà chị có bé 2 tuổi nên cần loại an toàn.",
              "expect": {
                "has_children": true
              }
            }
          ],
          "source": "claude-synth (fold 'bể' = 'be')",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        }
      ]
    },
    "room_area_m2": {
      "description": "diện tích phòng (m²)",
      "entries": [
        {
          "id": "room_area_m2.neg.kich_thuoc_vat",
          "kind": "negative",
          "drop_if_value_in_match": true,
          "pattern": "\\b(cao|dai|rong|sau|cach|day|ke|tu|cua)\\s+(khoang |tam )?\\d{1,3}\\s*(m|met)\\b(?! vuong)",
          "examples": [
            {
              "text": "Kệ cao 1 mét thì đặt máy lên được không?",
              "expect": {
                "room_area_m2": null
              }
            },
            {
              "text": "Phòng ngủ 25 mét vuông thì dùng loại nào em?",
              "expect": {
                "room_area_m2": 25
              }
            },
            {
              "text": "Phòng khách rộng 30m2 em nhé.",
              "expect": {
                "room_area_m2": 30
              }
            }
          ],
          "source": "claude-synth (đơn vị mét không phải diện tích)",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        }
      ]
    },
    "callback_requested": {
      "description": "thời điểm khách hẹn liên lạc lại (cần ngày giờ, parser parse_relative_datetime)",
      "entries": [
        {
          "id": "callback.trigger.nhan_tin_lai",
          "kind": "trigger",
          "pattern": "\\b(nhan tin lai|nhan lai|inbox lai|phan hoi lai|lien he lai|alo lai|hen lai|zalo lai)\\b",
          "examples": [
            {
              "text": "Mai 9h em nhắn tin lại cho chị nhé.",
              "expect": {
                "callback_requested": "*"
              }
            },
            {
              "text": "Shop phản hồi lại chậm quá.",
              "expect": {
                "callback_requested": null
              }
            }
          ],
          "source": "ref:hcmut-ura (đếm thô 01/11: ~80 câu hẹn liên hệ lại)",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        }
      ]
    },
    "blocker": {
      "description": "rào cản khiến khách chưa quyết",
      "entries": [
        {
          "id": "blocker.value.tham_khao_cho_khac",
          "kind": "value",
          "value": "so sanh gia",
          "pattern": "\\b(tham khao (them )?(vai|may|cac) (cho|noi|ben)|xem (them )?(ben|cho) khac|so (voi|thu) (cho|ben) khac)\\b",
          "examples": [
            {
              "text": "Để chị tham khảo thêm vài chỗ đã nhé.",
              "expect": {
                "blocker": "so sanh gia"
              }
            },
            {
              "text": "Bên em có chỗ nào khác ở Đà Nẵng không?",
              "expect": {
                "blocker": null
              }
            }
          ],
          "source": "claude-synth",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        },
        {
          "id": "blocker.value.hoi_nguoi_khac",
          "kind": "value",
          "value": "can nhac",
          "pattern": "\\b(de|cho) (anh|chi|em|minh|co|chu) (hoi|ban|trao doi|xin y kien) (them )?(sep|ke toan|cong ty|ban|team|nhom|y kien)\\b",
          "examples": [
            {
              "text": "Để chị hỏi kế toán bên chị đã rồi báo em.",
              "expect": {
                "blocker": "can nhac"
              }
            },
            {
              "text": "Chị hỏi chút, máy này bảo hành bao lâu?",
              "expect": {
                "blocker": null
              }
            }
          ],
          "source": "ref:hcmut-ura (khách B2B hỏi ý sếp/kế toán)",
          "added": "2026-11-01",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "Bùi Thành Đồng (duyệt cả lô, 2026-11-01)"
        },
        {
          "id": "blocker.value.de_xem_qua",
          "kind": "value",
          "value": "can nhac",
          "pattern": "\\b(de|cho) (minh|em|anh|chi|co|chu|toi) (xem (qua|lai|them)|tinh (lai|them)|nghi (them|lai)|xem)\\b(?! (gia|mau|hang|san pham|giup|ho|cho|don|thu))",
          "examples": [
            {
              "text": "Okie cảm ơn, để mình xem qua nha.",
              "expect": {
                "blocker": "can nhac"
              }
            },
            {
              "text": "Vậy để chị xem lại.",
              "expect": {
                "blocker": "can nhac"
              }
            },
            {
              "text": "Ok để anh xem.",
              "expect": {
                "blocker": "can nhac"
              }
            },
            {
              "text": "Để anh xem giá bên em thế nào đã.",
              "expect": {
                "blocker": null
              }
            },
            {
              "text": "Em xem lại giúp chị đơn hàng nhé.",
              "expect": {
                "blocker": null
              }
            }
          ],
          "source": "ref:hcmut-ura (mine_lexicon 02/11: 'de minh xem' 6, 'de minh xem qua' 4)",
          "added": "2026-11-02",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "claude (user-delegated 02/11, D14)"
        },
        {
          "id": "blocker.value.trao_doi_them",
          "kind": "value",
          "value": "can nhac",
          "pattern": "\\b(de|cho) (minh|em|anh|chi|co|chu|toi) (trao doi|ban bac|thong nhat) (them|lai|da)\\b",
          "examples": [
            {
              "text": "Để mình trao đổi thêm rồi báo lại nha.",
              "expect": {
                "blocker": "can nhac"
              }
            },
            {
              "text": "Chị muốn trao đổi về chính sách đổi trả.",
              "expect": {
                "blocker": null
              }
            }
          ],
          "source": "ref:hcmut-ura (mine_lexicon 02/11: 'trao doi voi' 8)",
          "added": "2026-11-02",
          "added_by": "claude",
          "status": "approved",
          "reviewed_by": "claude (user-delegated 02/11, D14)"
